#!/usr/bin/env php
<?php

declare(strict_types=1);

use voku\AgentLearning\Cli;
use voku\AgentLearning\FindingExporter;

spl_autoload_register(static function (string $class): void {
    $prefix = 'voku\\AgentLearning\\';
    if (!str_starts_with($class, $prefix)) {
        return;
    }

    $path = __DIR__ . '/../src/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
    if (is_file($path)) {
        require $path;
    }
});

$run = static function (array $argv): int {
    if (($argv[1] ?? null) === 'finding-export') {
        return (new FindingExporter())->run(array_slice($argv, 2));
    }

    return (new Cli())->run($argv);
};

if (class_exists(Cli::class)) {
    exit($run($argv));
}

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    getcwd() . '/vendor/autoload.php',
];

foreach ($autoloadCandidates as $autoloadCandidate) {
    if (is_file($autoloadCandidate)) {
        require $autoloadCandidate;
        exit($run($argv));
    }
}

fwrite(STDERR, "Cannot find Composer autoload file for voku/agent-learning.\n");
exit(1);
